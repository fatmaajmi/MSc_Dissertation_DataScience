(f\"===== Fold {fold_idx}/{N_SPLITS} =====\")\n","\n","    X_tr_raw, X_val_raw = X_all.iloc[train_idx], X_all.iloc[val_idx]\n","    y_tr, y_val = y_all.iloc[train_idx].values, y_all.iloc[val_idx].values\n","\n","    # Scale on each fold's training data (avoids leakage)\n","    scaler = StandardScaler()\n","    X_tr = scaler.fit_transform(X_tr_raw)\n","    X_val = scaler.transform(X_val_raw)\n","\n","    # Frequentist LR\n","    freq_model = LogisticRegression(penalty=None, max_iter=1000, random_state=RANDOM_STATE)\n","    freq_model.fit(X_tr, y_tr)\n","    freq_probs = freq_model.predict_proba(X_val)[:, 1]\n","    freq_preds = (freq_probs >= 0.5).astype(int)\n","\n","    # Bayesian LR\n","    with pm.Model() as logistic_model:\n","        X_data = pm.Data(\"X_data\", X_tr)\n","        y_data = pm.Data(\"y_data\", y_tr)\n","\n","        intercept = pm.Normal(\"intercept\", mu=0, sigma=1)\n","        betas = pm.Normal(\"betas\", mu=0, sigma=0.5, shape=n_features)\n","\n","        logits = intercept + pm.math.dot(X_data, betas)\n","        p = pm.Deterministic(\"p\", pm.math.sigmoid(logits))\n","        likelihood = pm.Bernoulli(\"y_obs\", logit_p=logits, observed=y_data)\n","\n","        trace = pm.sample(\n","            draws=1000, tune=1500, chains=2, cores=2,\n","            target_accept=0.95, random_seed=RANDOM_STATE,\n","            progressbar=False, return_inferencedata=True\n","        )\n","\n","\n","        pm.set_data({\"X_data\": X_val, \"y_data\": np.zeros(X_val.shape[0], dtype=int)})\n","        ppc = pm.sample_posterior_predictive(\n","            trace, var_names=[\"p\"], progressbar=False, random_seed=RANDOM_STATE\n","        )\n","\n","    bayes_probs = ppc.posterior_predictive[\"p\"].mean(dim=(\"chain\", \"draw\")).values\n","    bayes_preds = (bayes_probs >= 0.5).astype(int)\n","\n","    # Performance Metrics\n","    for name, probs, preds in [(\"Bayesian\", bayes_probs, bayes_preds),\n","                                 (\"Frequentist\", freq_pr